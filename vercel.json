{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "garuda-web",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    },
    {
      "src": "vercel/functions/handler.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30 }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/cesium/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/cesium/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/vercel/functions/handler.py"
    },
    {
      "src": "/health(.*)",
      "dest": "/vercel/functions/handler.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "env": {
    "ENVIRONMENT": {
      "description": "Application environment (development/production)",
      "default": "development"
    },
    "SECRET_KEY": {
      "description": "Secret key for FastAPI/signing",
      "default": "garuda-dev-secret-key-change-in-production"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string (required for production)",
      "optional": true
    },
    "GARUDA_BACKEND_URL": {
      "description": "Deprecated - Garuda backend now runs on Vercel serverless",
      "sensitive": true
    }
  },
  "installCommand": "cd frontend && npm install --no-audit --no-fund",
  "buildCommand": "cd frontend && npx tsc --noEmit && vite build",
  "framework": "python"
}
