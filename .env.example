# Garuda Environment Configuration Template
# Copy this file to .env for local development

# Application Mode
ENVIRONMENT=development
DEBUG=true

# Database Connection (SQLite for local-first, PostgreSQL for shared production)
DATABASE_URL=sqlite:///./garuda_local.db

# Security & Secrets (Development placeholders; use 32+ chars in production)
SECRET_KEY=garuda-insecure-dev-secret-replace-in-production-32chars
ADMIN_API_KEY=garuda-local-dev-admin-key-2026

# Regional Scope
PILOT_REGION=IN-OD

# Rate Limiting & Networking
RATE_LIMIT_ENABLED=true
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
LOG_JSON=false
LOG_LEVEL=INFO

# Legacy/Alternative Alias Prefixes (Also supported by backend):
# GARUDA_ENV=development
# GARUDA_DEBUG=true
# GARUDA_DATABASE_URL=sqlite:///./garuda_local.db
# GARUDA_SECRET_KEY=dev-only-secret-key-change-in-production
# GARUDA_ADMIN_API_KEY=garuda-local-dev-admin-key-2026
# GARUDA_PILOT_REGION=IN-OD
