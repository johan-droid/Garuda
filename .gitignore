# ---------------------------------------------------------------------------
# Garuda — Production Git Ignore Policy
# Strictly permits only production code, fixtures, and documentation.
# ---------------------------------------------------------------------------

# --- Python & Bytecode -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
bin/
var/
sdist/
develop-eggs/
.installed.cfg
pip-wheel-metadata/
backend/dist/
backend/build/
backend/*.egg-info/

# --- Virtual Environments --------------------------------------------------
.venv/
.venv
backend/.venv
frontend/.venv
venv/
env/
ENV/
.python-version

# --- Testing, Coverage & Typecheck Caches ----------------------------------
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
backend/.mypy_cache/
.ruff_cache/
backend/.ruff_cache/
.pytype/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage/
backend/coverage/
frontend/coverage/
htmlcov/
.tox/
.nox/
playwright-report/
test-results/

# --- TypeScript & Node Build Artifacts -------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vite/
.vite/
.cache/
storybook-static/
*.tsbuildinfo
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# --- Environment & Sensitive Credentials -----------------------------------
# Real configuration must NEVER be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
*.token

# --- Local Databases & Transient Stores ------------------------------------
# Databases are seeded dynamically via `make seed` or seed_pilot.py
*.db
*.db-journal
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
garuda_local.db
backend/garuda_local.db

# --- Backups & Snapshots ---------------------------------------------------
backups/
backend/backups/
*.db.gz
*.sql.gz

# --- Logs & Process Output -------------------------------------------------
*.log
logs/
npm-debug.log
pip-log.txt

# --- Editor, IDE & Operating System Artifacts ------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Temporary, Scratch & Swap Files ---------------------------------------
*.tmp
*.bak
*.orig
*.rej
scratch/

# Cesium runtime assets copied from node_modules by vite.config.ts
frontend/public/cesium/
